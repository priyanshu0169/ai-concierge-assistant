# ---------------------------------------------------------------------------
# ShopSage environment TEMPLATE.
#
# *** This file is COMMITTED. It must never contain a real credential. ***
# Every secret goes in .env, which .gitignore excludes.
#
# This file describes INFRASTRUCTURE and SECRETS only. Anything
# customer-facing or store-specific (assistant name, prompts, branding,
# feature flags) belongs in the site profile JSON instead.
# See docs/Configuration.md for the full contract.
#
# Usage:  cp .env.example .env    then fill in .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
SERVICE_NAME=shopsage-backend
LOG_LEVEL=info
# json = machine readable (use in production), pretty = human readable (dev)
LOG_FORMAT=pretty

# Path to the active site profile, relative to the repository root.
# Point this at a store-specific profile when deploying.
SITE_PROFILE_PATH=./config/site-profile.json

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the assistant API.
# The Magento storefront origin(s) go here. Use * for local development only.
CORS_ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
# Set to true ONLY when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY=false

# --- LLM gateway (OpenAI-compatible) --------------------------------------
# Any OpenAI-compatible endpoint works: internal AI gateway, Azure OpenAI,
# LiteLLM, OpenRouter, vLLM, OpenAI. Consumed by @shopsage/llm-client only.
#
# *** REQUIRED. *** The backend refuses to start without these three, and says
# which ones are missing. An assistant with no model cannot answer anything, and
# failing at boot beats failing on a customer's first question.
#
# LLM_BASE_URL is the API base, e.g. https://api.openai.com/v1 - the
# /chat/completions path is appended. A complete completions URL is also
# accepted, which is how Azure deployments are addressed.
# NEVER put a real credential in this file - it is tracked by git. Put it in
# .env, which is ignored.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Per-attempt budget, not a total. Worst case is LLM_TIMEOUT_MS *
# LLM_MAX_ATTEMPTS plus backoff - though timeouts are never retried, so in
# practice a slow gateway fails once at the budget. See docs/adr/0012.
LLM_TIMEOUT_MS=60000
LLM_MAX_ATTEMPTS=3

# bearer for every OpenAI-compatible gateway; api-key for Azure OpenAI.
LLM_AUTH_STYLE=bearer

# Ask for token counts on streamed responses. Set false only for the stricter
# gateways that reject the stream_options field - cost visibility is lost.
LLM_STREAM_INCLUDE_USAGE=true

# --- Embeddings ------------------------------------------------------------
# Backend-agnostic. `openai` speaks the OpenAI embeddings wire format to any
# compatible endpoint; `tei` speaks to a self-hosted HuggingFace service.
# Switching is these variables plus a re-ingestion - never a code change.
EMBEDDING_PROVIDER=openai

# *** REQUIRED. *** Usually the same gateway that serves the LLM, with the same
# credential: most OpenAI-compatible gateways expose /embeddings alongside
# /chat/completions. Give the API base; /embeddings is appended.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# bearer for every OpenAI-compatible gateway; api-key for Azure OpenAI.
EMBEDDING_AUTH_STYLE=bearer

# EMBEDDING_DIMENSIONS must match the model's native output width, or every
# response is rejected: 1536 for text-embedding-3-small, 1024 for BAAI/bge-m3,
# 384 for BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000

# Prepended to queries only, never to documents. Empty for text-embedding-3-small
# and bge-m3; the smaller BGE models need one or retrieval degrades silently.
EMBEDDING_QUERY_PREFIX=

# --- Self-hosted embeddings (optional) -------------------------------------
# To generate embeddings locally instead, start the profile and point at it:
#   docker compose --profile selfhosted up
#
#   EMBEDDING_PROVIDER=tei
#   EMBEDDING_BASE_URL=http://shopsage-embeddings:80
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIMENSIONS=1024
#
# Unlike QDRANT_URL and REDIS_URL above, this is NOT one you can leave at the Docker
# service name and forget about. docker-compose.yml deliberately does not override
# EMBEDDING_BASE_URL for the container - it forwards this file's value through
# unchanged - so the Docker hostname above only works while the backend or CLI is
# itself running inside Docker. Running locally against a self-hosted embeddings
# container needs http://localhost:${EMBEDDINGS_PORT:-8080} instead. The hosted-gateway
# EMBEDDING_BASE_URL earlier in this file has none of this concern: it is a real
# external address, identical from both sides.
#
# Which model that container serves. Must agree with EMBEDDING_MODEL above.
SELF_HOSTED_EMBEDDING_MODEL=BAAI/bge-m3

# --- Vector database (Qdrant) ---------------------------------------------
# localhost, not the Docker service name - and this is safe to leave as-is in every
# context, never just for the one you set it up for. docker-compose.yml hardcodes
# QDRANT_URL for the backend container's own environment regardless of what this file
# says, so this line is read only by a bare `node` process outside Docker (the
# ingestion CLI, npm run dev, a test) - and Qdrant's container port is published to
# localhost precisely so that case works with no further editing. See docs/Docker.md.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=shopsage_knowledge
QDRANT_TIMEOUT_MS=10000

# Authentication is off unless BOTH of these are set - the server requires the
# key, the client presents it. Leave both absent for local development, where
# Qdrant is bound to loopback; set both for anything shared. Do not set only
# QDRANT__SERVICE__API_KEY, or the backend will be locked out of its own store.
#
# QDRANT_API_KEY=change-me            # presented by the backend
# QDRANT__SERVICE__API_KEY=change-me  # required by Qdrant itself

# --- Authentication (Magento-issued session tokens) -----------------------
# Magento mints a short-lived ES256 JWT for each storefront session; ShopSage
# verifies it against the published key set. ShopSage holds NO private key and
# issues nothing - it cannot mint a token for a customer, by design.
#
# Deliberately has NO default in production: the backend refuses to boot without
# an explicit choice. Serving unauthenticated is legitimate behind a VPN whose
# proxy authenticates, and catastrophic anywhere else. Outside production it
# defaults to off, and every request gets a synthetic guest session.
AUTH_ENABLED=
# Expected `iss` - the Magento instance that mints tokens.
AUTH_ISSUER=
# Expected `aud`, store-specific by agreement: shopsage-<store-id>. Store-specific
# so a token minted for one deployment cannot be presented to another.
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# The algorithm THIS deployment performs. The token's own `alg` header is only
# compared against it, never used to choose a method - doing that is the classic
# JWT break. HS256 is not offered at any setting: a symmetric key would let
# ShopSage mint tokens, making a compromise here an identity compromise.
AUTH_ALGORITHM=ES256
AUTH_CLOCK_SKEW_SECONDS=60
AUTH_JWKS_CACHE_TTL_MS=600000

# --- Rate limiting and capacity -------------------------------------------
# Applies to /v1 only. Health endpoints are never throttled: an orchestrator
# polls readiness on a fixed interval, and refusing it would make a healthy
# instance report a false outage.
#
# NOTE: limiter state is per process, so with N replicas the effective
# allowance is N x RATE_LIMIT_MAX_REQUESTS. Divide accordingly.
#
# NOTE: with AUTH_ENABLED=true, limits key on the session's pseudonymous
# subject rather than an IP - a shared NAT stops looking like one abuser. With
# auth off they key on the address, so TRUST_PROXY must match your topology:
# on without a proxy lets a caller forge its identity; off behind one puts
# every customer in the same bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# A request is spent; a stream is HELD, for the length of an answer. Counted
# separately for that reason. Per-client excess is 429 (the client's fault);
# the process-wide ceiling is 503 (the service is full, nobody's fault).
MAX_CONCURRENT_STREAMS_PER_CLIENT=2
MAX_CONCURRENT_STREAMS=50

# --- Conversation history -------------------------------------------------
# Where a customer's conversation is remembered between questions.
#
#   memory  in-process. Correct for development and for exactly ONE replica.
#           Behind two, whichever replica the load balancer picks decides
#           whether the assistant remembers - which looks like an assistant
#           that forgets at random, not like a misconfiguration.
#   redis   shared. Required for more than one replica.
#
# Deliberately has NO default in production: the backend refuses to boot
# without an explicit choice, because only you know the replica count. Outside
# production it defaults to `memory`, so this can be left blank for local work.
CONVERSATION_STORE=
# localhost, not the Docker service name - same reasoning as QDRANT_URL above:
# docker-compose.yml hardcodes REDIS_URL for the backend container regardless of this
# file, so this line only matters outside Docker, where Redis's container port is
# published to localhost for exactly this reason.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=shopsage:conv
REDIS_TIMEOUT_MS=5000

# Capabilities the synthetic guest session holds when AUTH_ENABLED=false.
# Development only - ignored entirely when authentication is on, where scopes come
# from the verified token. Defaults to `chat` alone so the gating path is exercised
# locally rather than bypassed; widen it to reach the order and cart features without
# a real issuer. The backend warns at boot when it has been widened.
#
# Left at the default here on purpose: this file is committed, and a widened default in it
# would make "every developer's guest session can confirm cart changes" the starting point
# for anyone who copies it. Set it in your own .env if you need it.
DEV_SESSION_SCOPES=chat

# --- Metrics --------------------------------------------------------------
# Publish GET /metrics in the Prometheus exposition format. Off by default, and
# deliberately: the payload says how many customers asked questions, how many tokens
# the store paid for, and which dependencies are failing - a business intelligence
# feed for a competitor and a map of what is broken for anybody probing.
#
# METRICS_TOKEN is REQUIRED whenever it is on. The backend refuses to boot with the
# endpoint enabled and no token rather than serving it open. Minimum 16 characters.
METRICS_ENABLED=false
METRICS_TOKEN=

# --- Commerce connector ---------------------------------------------------
# Base URL of the store connector exposing the /assistant/v1 REST APIs, ending
# *before* /assistant/v1. ShopSage only ever talks to it over HTTP.
#
# Required as soon as any commerce feature is on in config/site-profile.json -
# productSearch, productComparison, recommendations, orderTracking, cart or
# coupons. The backend refuses to boot with a commerce feature enabled and no
# URL here, and names the feature, because the alternative is an assistant that
# silently cannot answer any question about prices.
#
# For local work without a Magento instance, run the reference connector:
#   docker compose --profile reference up
#   MAGENTO_API_URL=http://shopsage-reference-connector:8750
# It serves a fictional catalogue and does not verify token signatures, so it is
# a development aid only - never point a real deployment at it.
#
# Unlike QDRANT_URL and REDIS_URL, this address is NOT safe to leave at the Docker
# hostname unconditionally. docker-compose.yml deliberately does not default or
# override MAGENTO_API_URL for the container - it forwards this file's value straight
# through - specifically so a real deployment can never silently fall back to the
# fictional reference connector. That means this one genuinely does depend on where
# the backend or CLI itself is running: the Docker hostname above if it runs inside
# Docker too (the usual way to use the reference connector), or
# http://localhost:${REFERENCE_CONNECTOR_PORT:-8750} if you are running the backend or
# a CLI locally against a Dockerized reference connector. Switching which of those
# you are doing is the one case in this file that still needs an edit, and it is
# deliberate rather than an oversight.
MAGENTO_API_URL=
# ShopSage's *own* credential, identifying the service to the connector. This is
# not the customer's session token, which arrives per request and is forwarded
# separately. Leave blank if the connector does not require one.
MAGENTO_API_TOKEN=
# Per-call budget and attempts for a read. Reads retry; writes never will.
MAGENTO_TIMEOUT_MS=5000
MAGENTO_MAX_ATTEMPTS=2

# --- Docker Compose host port mappings ------------------------------------
BACKEND_PORT=3000
QDRANT_HTTP_PORT=6333
EMBEDDINGS_PORT=8080
REDIS_PORT=6379
# Redis holds conversations that expire on their own, so it runs without disk
# persistence and evicts the closest-to-expiring first under pressure.
REDIS_MAXMEMORY=256mb
